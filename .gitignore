# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment — never commit real secrets. `.env.example` IS committed.
.env
.env.*
!.env.example

# Testing
coverage/
*.lcov
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS
.DS_Store
Thumbs.db
._*

# Editors
.idea/
*.swp
*.swo
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- React Native / Android ---
.gradle/
local.properties
*.hprof
.cxx/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/

# Metro / Haste
.metro-health-check*
metro-cache/
