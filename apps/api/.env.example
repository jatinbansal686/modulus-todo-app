# Copy to `.env` and fill in. Every value here is validated at boot (see
# src/config/env.validation.ts) — the app refuses to start on a bad config rather
# than failing later on a request.
#
# Generate the three secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000

# Local: mongodb://127.0.0.1:27017/modulus_todo
# Atlas: mongodb+srv://<user>:<password>@<cluster>/modulus_todo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/modulus_todo

# Signs access tokens. Minimum 32 characters.
JWT_ACCESS_SECRET=replace-me-with-32-plus-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Refresh tokens are stored as an HMAC of the token, keyed by this pepper, so a
# database leak alone does not yield usable tokens.
REFRESH_TOKEN_PEPPER=replace-me-with-32-plus-random-characters

# Passed to argon2 as its native `secret` option, so a leaked password hash cannot
# be cracked offline without also having this value.
PASSWORD_PEPPER=replace-me-with-32-plus-random-characters

# Comma-separated allowlist. Leave empty for local development. Never use '*'.
CORS_ORIGINS=

# Requests per minute per IP against the auth endpoints.
AUTH_RATE_LIMIT=10

# Number of reverse proxies in front of the app. 0 locally; 1 on Render/Heroku.
# If this is wrong behind a proxy, per-IP rate limiting silently becomes global.
TRUST_PROXY=0
