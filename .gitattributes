# Normalise line endings so a Windows reviewer doesn't see the whole tree as modified.
* text=auto eol=lf

# Scripts must stay LF or they break when executed.
*.sh      text eol=lf
gradlew   text eol=lf

# Windows-only files.
*.bat     text eol=crlf
gradlew.bat text eol=crlf

# Lockfiles: generated, so keep them out of diffs and language stats.
package-lock.json -diff linguist-generated=true

# Binary assets — never try to diff or merge these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.mp4     binary
*.keystore binary
*.jar     binary
*.aab     binary
*.apk     binary
*.ttf     binary
*.otf     binary
